#!/bin/bash

# Pre-commit guard: catch, at the earliest possible point, the two failures that keep
# reaching CI/push during large refactors - because the existing gates fire at push
# (snapshot) or in CI (format:check), by which time the bad state has already landed
# in a commit.
#
#  1. Unformatted files (recurred: NEW-26 / rev 2, both during big refactors).
#     format:check is CI's FIRST step, so a single unformatted file fails CI before
#     anything downstream runs. Block a commit that stages a file Prettier would rewrite.
#
#  2. Stale rebuild snapshot (recurred 5x: NEW-27 the latest, first since the pre-push
#     hook was added). A migration committed without regenerating the snapshot drifts
#     the one-shot provisioning file. The pre-push hook already blocks the PUSH; this
#     blocks the COMMIT that introduces it, so migration + snapshot stay atomic and the
#     drift never enters history.
#
# Both reuse the exact scripts/commands CI runs, so local and CI verdicts can't diverge.
# Bypass in a genuine emergency with `git commit --no-verify`.
#
# Enabled via core.hooksPath=.githooks (set by the package.json "prepare" script).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_all=$(git diff --cached --name-only --diff-filter=ACM)

# 1) Formatting - only the Prettier-handled files staged for THIS commit.
staged_fmt=$(echo "$staged_all" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|md|css|ya?ml)$' || true)
if [ -n "$staged_fmt" ]; then
  if ! echo "$staged_fmt" | xargs -d '\n' npx prettier --check >/dev/null 2>&1; then
    echo "" >&2
    echo "pre-commit blocked: staged files are not Prettier-formatted (CI's format:check would fail first)." >&2
    echo "Fix: npm run format  (or npx prettier --write on the files), then 'git add' and commit again." >&2
    echo "Offending files:" >&2
    echo "$staged_fmt" | xargs -d '\n' npx prettier --list-different >&2 || true
    exit 1
  fi
fi

# 2) Snapshot freshness - only when this commit includes a migration.
if echo "$staged_all" | grep -qE '^supabase/migrations/.*\.sql$'; then
  if [ -f scripts/check-snapshot-freshness.sh ] && ! bash scripts/check-snapshot-freshness.sh; then
    echo "" >&2
    echo "pre-commit blocked: this commit adds a migration but the rebuild snapshot is stale." >&2
    echo "Regenerate it in the SAME commit:" >&2
    echo "  supabase db reset && npm run db:rebuild-snapshot && git add supabase/rebuild/0000_full_rebuild.sql" >&2
    exit 1
  fi
fi
