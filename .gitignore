# dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log

# testing
/coverage

# next.js
.next/
/out/
build/

# misc
.DS_Store
*.pem

# mock mode (local dev only)
.env.local
.mock-db.json
.mock-db.lock
.mock-storage/
.ck-*
scratch-*

# env files (can be committed if public, but usually ignored)
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (E2E run artifacts — the specs + config ARE committed)
test-results/
playwright-report/
playwright-report-staging/
.playwright/

# Local Claude Code tooling config (per-machine; never shared)
.claude/

# Auto-generated agent rule files (Next 16 emits these on build; regenerated, not source)
/AGENTS.md
/CLAUDE.md

# Supabase CLI scratch (version cache) - machine-local, never part of the repo.
supabase/.temp/
