# ── Quick start: run locally in MOCK MODE (no Supabase / Google needed) ───────
# Copy this file to .env.local and `npm run dev`. The portal runs against a
# JSON-file fake of Supabase; sign in at /login with a demo account
# (e.g. admin@mock.test / cert-ed — also tutor@, mentor@, student@mock.test).
# See docs/setup-guide.md to go live, and docs/environment.md for every variable.
# NOTE: these MOCK_* vars are for `npm run dev` only. `npm run build` runs as production
# and the mock-config guard refuses to build with them set. For a local production build,
# unset MOCK_MODE / NEXT_PUBLIC_MOCK_MODE, or run it with E2E_BUILD=1.
MOCK_MODE=1
NEXT_PUBLIC_MOCK_MODE=1
NEXT_PUBLIC_SUPABASE_URL=http://mock.local        # sentinel so the env-guards treat the portal as configured
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=mock-publishable-key   # sentinel (unused in mock mode)
APP_HOSTNAME=app.certedacademia.com
MARKETING_HOSTNAME=certedacademia.com
# MOCK_PASSWORD=cert-ed                            # shared password for the seeded demo users (optional)
# MOCK_CHROME_PATH=                                # Chrome path for finance-PDF rendering in dev (optional)

# ── Production: Supabase (set these real values and MOCK_MODE=0) ───────────────
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=                            # server only — never expose to the client
# PRODUCTION_SEED_ADMIN_EMAIL=                    # the three allowlist entries seeded by
# PRODUCTION_SEED_TEACHER_EMAIL=                  # scripts/seed-production-allowlist.mjs
# PRODUCTION_SEED_STUDENT_EMAIL=                  # (or pass them as positional CLI args)
# CRON_SECRET=                                     # protects /api/cron/*

# ── Email notifications via Resend (optional; off unless ALL three are set) ───
# Mirrors in-app notifications to email. Best-effort; never blocks the in-app write.
# EMAIL_NOTIFICATIONS_ENABLED=true
# RESEND_API_KEY=                                  # server only
# EMAIL_FROM="Cert-Ed Academia <notify@certedacademia.com>"   # a Resend-verified sender
# NEXT_PUBLIC_APP_URL=https://app.certedacademia.com          # absolutises links in emails

# ── Error tracking via Sentry (optional; off unless the DSN is set) ────────────
# SENTRY_DSN=                                      # server/edge capture (also feeds logError)
# NEXT_PUBLIC_SENTRY_DSN=                          # browser capture

# ── Marketing contact form (optional) ─────────────────────────────────────────
# GOOGLE_SCRIPT_URL=                               # Google Apps Script web app for the contact form

# ── Google Drive custodial attachment storage (optional) ──────────────────────
# Uploaded files (submissions, resources, announcements) are stored in the
# academy's OWN Google Drive account and streamed back through the app — never
# shared by a public link. SERVER-ONLY (never NEXT_PUBLIC): a refresh token for a
# dedicated Drive account is exchanged for short-lived access tokens. Leave unset
# to keep the manual paste-a-link flow. Does NOT run in mock mode.
# Run scripts/get-drive-refresh-token.mjs for the one-time consent + refresh-token
# mint; see docs/deployment.md and docs/environment.md for the full steps.
# GOOGLE_DRIVE_CLIENT_ID=                          # OAuth 2.0 client id (server)
# GOOGLE_DRIVE_CLIENT_SECRET=                      # OAuth 2.0 client secret (server)
# GOOGLE_DRIVE_REFRESH_TOKEN=                      # refresh token for the academy Drive account
# GOOGLE_DRIVE_ROOT_FOLDER_ID=                     # Drive folder new uploads are filed under
